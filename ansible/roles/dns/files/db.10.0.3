; BIND reverse data file for empty rfc1918 zone
;
; DO NOT EDIT THIS FILE - it is used for multiple zones.
; Instead, copy it, edit named.conf, and use that copy.
;
$TTL    86400
@       IN      SOA     lab.pl. root.lab.pl. (
                       25052025         ; Serial
                         604800         ; Refresh
                          86400         ; Retry
                        2419200         ; Expire
                          86400 )       ; Negative Cache TTL
;
        IN      NS      ns1.lab.pl.
        IN      NS      ns2.lab.pl.

;Hostname
2      IN      PTR     dv-bastion1.lab.pl.
3      IN      PTR     dv-bastion2.lab.pl.
4      IN      PTR     pr-bastion1.lab.pl.
5      IN      PTR     pr-bastion2.lab.pl.
