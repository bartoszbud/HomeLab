; BIND reverse data file for empty rfc1918 zone
;
; DO NOT EDIT THIS FILE - it is used for multiple zones.
; Instead, copy it, edit named.conf, and use that copy.
;
$TTL    86400
@       IN      SOA     lab.pl. root.lab.pl. (
                       22092026         ; Serial
                         604800         ; Refresh
                          86400         ; Retry
                        2419200         ; Expire
                          86400 )       ; Negative Cache TTL
;
        IN      NS      ns1.lab.pl.
        IN      NS      ns2.lab.pl.

;Hostname
12      IN      PTR     dv-nfs1.lab.pl.
13      IN      PTR     dv-st1.lab.pl.
14      IN      PTR     dv-st2.lab.pl.
15      IN      PTR     dv-st3.lab.pl.
16      IN      PTR     dv-db1.lab.pl.
16      IN      PTR     dv-db2.lab.pl.
12      IN      PTR     pr-nfs1.lab.pl.
13      IN      PTR     pr-st1.lab.pl.
14      IN      PTR     pr-st2.lab.pl.
15      IN      PTR     pr-st3.lab.pl.
16      IN      PTR     pr-db1.lab.pl.
16      IN      PTR     pr-db2.lab.pl.
