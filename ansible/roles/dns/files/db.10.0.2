; BIND reverse data file for empty rfc1918 zone
;
; DO NOT EDIT THIS FILE - it is used for multiple zones.
; Instead, copy it, edit named.conf, and use that copy.
;
$TTL    86400
@       IN      SOA     lab.pl. root.lab.pl. (
                       25052025         ; Serial
                         604800         ; Refresh
                          86400         ; Retry
                        2419200         ; Expire
                          86400 )       ; Negative Cache TTL
;
        IN      NS      ns1.lab.pl.
        IN      NS      ns2.lab.pl.

4       IN      PTR     ns1.lab.pl.
5       IN      PTR     ns2.lab.pl.

;Hostname
2       IN      PTR     pr-dns1.lab.pl.
3       IN      PTR     pr-dns2.lab.pl.
4       IN      PTR     pr-dns1.lab.pl.
5       IN      PTR     pr-dns2.lab.pl.
6       IN      PTR     dv-lb1.lab.pl.
7       IN      PTR     dv-lb2.lab.pl.
8       IN      PTR     pr-lb1.lab.pl.
9       IN      PTR     pr-lb1.lab.pl.
10      IN      PTR     dv-rp1.lab.pl.
11      IN      PTR     dv-rp2.lab.pl.
12      IN      PTR     pr-rp1.lab.pl.
13      IN      PTR     pr-rp1.lab.pl.
