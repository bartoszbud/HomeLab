; BIND reverse data file for empty rfc1918 zone
;
; DO NOT EDIT THIS FILE - it is used for multiple zones.
; Instead, copy it, edit named.conf, and use that copy.
;
$TTL    86400
@       IN      SOA     lab.pl. root.lab.pl. (
                       22092026         ; Serial
                         604800         ; Refresh
                          86400         ; Retry
                        2419200         ; Expire
                          86400 )       ; Negative Cache TTL
;
        IN      NS      ns1.lab.pl.
        IN      NS      ns2.lab.pl.

;Hostname
10      IN      PTR     dv-kube-m1.lab.pl.
11      IN      PTR     dv-kube-m2.lab.pl.
12      IN      PTR     dv-kube-m3.lab.pl.
14      IN      PTR     dv-kube-w1.lab.pl.
15      IN      PTR     dv-kube-w2.lab.pl.
16      IN      PTR     dv-kube-w3.lab.pl.
