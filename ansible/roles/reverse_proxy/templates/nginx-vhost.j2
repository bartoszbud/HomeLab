upstream backend_{{ item.name | replace('.', '_') }} {
    {% for host in item.backend_hosts %}
    server {{ host }}:{{ item.listen_port }};
    {% endfor %}
}

server {
    listen 80;
    server_name www.{{ item.name }} {{ item.server_name }};

    location / {
        proxy_pass http://backend_{{ item.name | replace('.', '_') }};
        
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    access_log /var/log/nginx/access_{{ item.name }}.log;
    error_log /var/log/nginx/error_{{ item.name }}.log;
}