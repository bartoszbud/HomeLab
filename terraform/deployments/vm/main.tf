module "vm" {
  for_each            = var.vm_instances
  source              = "../../modules/vm"
  name                = each.value.name
  description         = each.value.description
  tags                = each.value.tags
  node_name           = each.value.target_node
  vm_id               = each.value.vmid
  stop_on_destroy     = each.value.stop_on_destroy
  cpu_cores           = each.value.cores
  cpu_sockets         = each.value.cpu_sockets
  cpu_type            = each.value.cpu_type
  memory_dedicated    = each.value.memory
  memory_floating     = each.value.balloon
  disk_datastore_id   = each.value.disk_datastore_id
  disk_import_from    = each.value.disk_import_from
  disk_interface      = each.value.disk_interface
  disk_size           = each.value.disk_size
  network_bridge      = each.value.network_bridge
  ip_address          = each.value.ip_address
  gateway             = each.value.gateway
  dns_domain          = each.value.dns_domain
  dns_servers         = each.value.dns_servers
  username            = each.value.username
  password            = each.value.password
  ssh_key             = each.value.ssh_key
  os_type             = each.value.os_type
  agent_enabled       = each.value.agent
  startup_order       = each.value.startup_order
  startup_up_delay    = each.value.startup_up_delay
  reboot_after_update = each.value.reboot_after_update
}
